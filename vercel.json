{
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/roofing",
      "destination": "/services/roofing.html",
      "permanent": true
    },
    {
      "source": "/impact-windows",
      "destination": "/services/impact-windows.html",
      "permanent": true
    },
    {
      "source": "/impact-doors",
      "destination": "/services/impact-doors.html",
      "permanent": true
    },
    {
      "source": "/windows",
      "destination": "/services/impact-windows.html",
      "permanent": true
    },
    {
      "source": "/doors",
      "destination": "/services/impact-doors.html",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/#estimate",
      "permanent": false
    },
    {
      "source": "/estimate",
      "destination": "/#estimate",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
